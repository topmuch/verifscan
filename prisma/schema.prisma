// VerifScan - Schéma de base de données
// SaaS de traçabilité produits par QR codes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          String   @default("fabricant") // 'superadmin' | 'fabricant'
  companyName   String?
  logoUrl       String?
  phone         String?
  whatsapp      String?
  emailContact  String?
  address       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products      Product[]
  scans         Scan[]
  subscription  Subscription?
  notifications Notification[]
  invoices      Invoice[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
}

model Product {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String
  name        String
  brand       String
  description String?
  photoUrl    String?
  weight      String?
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id])
  lots        Lot[]

  @@index([userId])
  @@index([categoryId])
}

model Lot {
  id                     String   @id @default(cuid())
  productId              String
  lotNumber              String   @unique
  manufacturingDate      DateTime
  expirationDate         DateTime
  ingredients            String?
  manufacturingLocation  String?
  transformationLocation String?
  salesCountries         String? // CSV: "Sénégal, Mali, Côte d'Ivoire"
  status                 String   @default("active") // 'active' | 'recalled'
  recallReason           String?
  recalledAt             DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qrCodes                QRCode[]

  @@index([productId])
  @@index([status])
}

model QRCode {
  id            String   @id @default(cuid())
  lotId         String
  publicUrl     String
  qrCodeImageUrl String?
  logoUrl       String?
  fgColor       String?  // foreground color (V2 customization)
  bgColor       String?  // background color (V2 customization)
  size          Int?     // size in pixels (V2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lot           Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  scans         Scan[]

  @@index([lotId])
}

model Scan {
  id          String   @id @default(cuid())
  qrCodeId    String
  userId      String?
  scannedAt   DateTime @default(now())
  location    String?
  deviceType  String?
  userAgent   String?
  country     String?
  city        String?
  ipAddress   String?

  qrCode      QRCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([qrCodeId])
  @@index([userId])
  @@index([scannedAt])
  @@index([country])
}

// === V2: Système d'abonnement ===

model Subscription {
  id              String   @id @default(cuid())
  userId          String   @unique
  plan            String   @default("starter") // 'starter' | 'pro' | 'enterprise'
  status          String   @default("trial") // 'trial' | 'active' | 'past_due' | 'canceled'
  qrCodesLimit    Int      @default(500)  // quota mensuel
  qrCodesUsed     Int      @default(0)
  productsLimit   Int      @default(5)    // -1 pour illimité
  trialEndsAt     DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices        Invoice[]
}

model Invoice {
  id              String   @id @default(cuid())
  userId          String
  subscriptionId  String
  amount          Int      // en FCFA
  plan            String
  periodStart     DateTime
  periodEnd       DateTime
  status          String   @default("paid") // 'paid' | 'failed' | 'pending'
  paymentMethod   String?  // 'cinetpay' | 'stripe' | 'manual'
  paymentRef      String?
  invoiceNumber   String   @unique
  pdfUrl          String?
  createdAt       DateTime @default(now())

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subscriptionId])
}

// === V2: Notifications ===

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   // 'recall_alert' | 'quota_warning' | 'new_scan' | 'weekly_report' | 'payment'
  title       String
  message     String
  isRead      Boolean  @default(false)
  link        String?
  metadata    String?  // JSON string for additional data
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}
