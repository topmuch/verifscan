// VerifScan - Schéma de base de données
// SaaS de traçabilité produits par QR codes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          String   @default("fabricant") // 'superadmin' | 'fabricant'
  companyName   String?
  logoUrl       String?
  phone         String?
  whatsapp      String?
  emailContact  String?
  address       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products      Product[]
  scans         Scan[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
}

model Product {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String
  name        String
  brand       String
  description String?
  photoUrl    String?
  weight      String?
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id])
  lots        Lot[]

  @@index([userId])
  @@index([categoryId])
}

model Lot {
  id                     String   @id @default(cuid())
  productId              String
  lotNumber              String   @unique
  manufacturingDate      DateTime
  expirationDate         DateTime
  ingredients            String?
  manufacturingLocation  String?
  transformationLocation String?
  salesCountries         String? // CSV: "Sénégal, Mali, Côte d'Ivoire"
  status                 String   @default("active") // 'active' | 'recalled'
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qrCodes                QRCode[]

  @@index([productId])
  @@index([status])
}

model QRCode {
  id            String   @id @default(cuid())
  lotId         String
  publicUrl     String
  qrCodeImageUrl String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lot           Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  scans         Scan[]

  @@index([lotId])
}

model Scan {
  id          String   @id @default(cuid())
  qrCodeId    String
  userId      String?
  scannedAt   DateTime @default(now())
  location    String?
  deviceType  String?
  userAgent   String?

  qrCode      QRCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([qrCodeId])
  @@index([userId])
  @@index([scannedAt])
}
