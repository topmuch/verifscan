// VerifScan - Schéma de base de données
// SaaS de traçabilité produits par QR codes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          String   @default("fabricant") // 'superadmin' | 'fabricant' | 'distributor'
  companyName   String?
  logoUrl       String?
  phone         String?
  whatsapp      String?
  emailContact  String?
  address       String?
  // Réseaux sociaux (renseignés par le fabricant, affichés sur sa fiche produit)
  socialFacebook   String?
  socialTwitter    String?
  socialLinkedin   String?
  socialInstagram  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products      Product[]
  scans         Scan[]
  subscription  Subscription?
  notifications Notification[]
  invoices      Invoice[]
  // V3 relations
  distributor             Distributor?
  b2bOrders               B2BOrder[]    @relation("FabricantOrders")
  messagesReceived        B2BMessage[]  @relation("ReceiverMessages")
  b2bSentMessages         B2BMessage[]  @relation("B2BSender")
  contracts               Contract[]    @relation("FabricantOrders")
  certifications          Certification[]
  exportDocuments         ExportDocument[]
  b2bReviewsReceived      B2BReview[]   @relation("FabricantReviews")
  productReviewsReceived  ProductReview[] @relation("ProductReviewFabricant")
  conversations           Conversation[]
}

model Category {
  id           String   @id @default(cuid())
  name         String   @unique
  icon         String?
  pageTemplate String   @default("standard") // 'standard' | 'export_produce' | 'artisanat' | 'cosmetique' | 'textile'
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products  Product[]
}

model Product {
  id                 String   @id @default(cuid())
  userId             String
  categoryId         String
  name               String
  brand              String
  description        String?
  photoUrl           String?
  weight             String?
  isVisible          Boolean  @default(true)
  // Champs spécifiques au template 'export_produce' (ignorés sinon)
  variety            String?   // ex: "Kent", "Keitt" pour les mangues
  regionOfProduction String?   // ex: "Casamance", "Vallée du fleuve Sénégal"
  producerStory      String?   // présentation/histoire du producteur
  producerPhotoUrl   String?   // photo du producteur/verger
  gpsLat             Float?
  gpsLng             Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id])
  lots        Lot[]
  // V3 relations
  b2bInfo     B2BProduct?
  conversations Conversation[]
  aiAnomalies AIAnomaly[]
  aiPredictions AIPrediction[]
  productReviews ProductReview[]

  @@index([userId])
  @@index([categoryId])
}

model Lot {
  id                     String   @id @default(cuid())
  productId              String
  lotNumber              String   @unique
  manufacturingDate      DateTime
  expirationDate         DateTime
  ingredients            String?
  manufacturingLocation  String?
  transformationLocation String?
  salesCountries         String? // CSV: "Sénégal, Mali, Côte d'Ivoire"
  status                 String   @default("active") // 'active' | 'recalled'
  recallReason           String?
  recalledAt             DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Champs spécifiques au template 'export_produce' (ignorés sinon)
  harvestDate            DateTime?  // date de récolte
  packagingDate          DateTime?  // date de conditionnement
  packagingStation       String?    // station de conditionnement
  containerNumber        String?    // n° de conteneur
  palletNumber           String?    // n° de palette
  shipDate               DateTime?  // date d'expédition
  destination            String?    // pays/ville de destination
  carrier                String?    // transporteur
  caliber                String?    // calibre (ex: "5-6", "Calibre A")
  avgWeightGram          Int?       // poids moyen (g)
  brix                   Float?     // taux de sucre (°Brix)
  storageTempC           Float?     // température de conservation (°C)
  shelfLifeDays          Int?       // durée de conservation (jours)

  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qrCodes                QRCode[]
  // V3 relations
  aiAnomalies            AIAnomaly[]
  blockchainCertificate  BlockchainCertificate?
  productReviews         ProductReview[]
  lotMedia               LotMedia[]

  @@index([productId])
  @@index([status])
}

model LotMedia {
  id        String   @id @default(cuid())
  lotId     String
  type      String   // 'photo' | 'video'
  url       String   // URL externe (YouTube/Vimeo pour les vidéos) ou locale
  caption   String?
  createdAt DateTime @default(now())

  lot       Lot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId])
}


model QRCode {
  id            String   @id @default(cuid())
  lotId         String
  publicUrl     String
  qrCodeImageUrl String?
  logoUrl       String?
  fgColor       String?  // foreground color (V2 customization)
  bgColor       String?  // background color (V2 customization)
  size          Int?     // size in pixels (V2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lot           Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  scans         Scan[]

  @@index([lotId])
}

model Scan {
  id          String   @id @default(cuid())
  qrCodeId    String
  userId      String?
  scannedAt   DateTime @default(now())
  location    String?
  deviceType  String?
  userAgent   String?
  country     String?
  city        String?
  ipAddress   String?
  // V4 — geolocation, photo, anonymous user tracking
  latitude    Float?
  longitude   Float?
  region      String?  // administrative region (e.g. "Dakar", "Thiès")
  photoUrl    String?  // optional photo taken by consumer at scan time
  photoMatchScore Float? // 0-100 — IA similarity vs reference packaging
  deviceFingerprint String? // anonymous browser fingerprint for history/rewards

  qrCode      QRCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  reward      RewardTransaction?

  @@index([qrCodeId])
  @@index([userId])
  @@index([scannedAt])
  @@index([country])
  @@index([region])
  @@index([deviceFingerprint])
}

// === V2: Système d'abonnement ===

model Subscription {
  id              String   @id @default(cuid())
  userId          String   @unique
  plan            String   @default("starter") // 'starter' | 'pro' | 'enterprise'
  status          String   @default("trial") // 'trial' | 'active' | 'past_due' | 'canceled'
  qrCodesLimit    Int      @default(500)  // quota mensuel
  qrCodesUsed     Int      @default(0)
  productsLimit   Int      @default(5)    // -1 pour illimité
  trialEndsAt     DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices        Invoice[]
}

model Invoice {
  id              String   @id @default(cuid())
  userId          String
  subscriptionId  String
  amount          Int      // en FCFA
  plan            String
  periodStart     DateTime
  periodEnd       DateTime
  status          String   @default("paid") // 'paid' | 'failed' | 'pending'
  paymentMethod   String?  // 'cinetpay' | 'stripe' | 'manual'
  paymentRef      String?
  invoiceNumber   String   @unique
  pdfUrl          String?
  createdAt       DateTime @default(now())

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subscriptionId])
}

// === V2: Notifications ===

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   // 'recall_alert' | 'quota_warning' | 'new_scan' | 'weekly_report' | 'payment' | 'ai_anomaly' | 'ai_prediction' | 'cert_expiring' | 'b2b_message' | 'b2b_order'
  title       String
  message     String
  isRead      Boolean  @default(false)
  link        String?
  metadata    String?  // JSON string for additional data
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// === V3: Module IA ===

model AIAnomaly {
  id          String   @id @default(cuid())
  type        String   // 'allergen' | 'dlc' | 'counterfeit' | 'ingredient' | 'cert_expiring'
  productId   String?
  lotId       String?
  fabricantId String
  severity    String   @default("info") // 'info' | 'warning' | 'critical'
  description String
  aiMetadata  String?  // JSON: détails (ingrédients suspects, pays, etc.)
  status      String   @default("open") // 'open' | 'resolved' | 'ignored'
  detectedAt  DateTime @default(now())
  resolvedAt  DateTime?

  lot         Lot?     @relation(fields: [lotId], references: [id], onDelete: SetNull)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([fabricantId])
  @@index([status])
  @@index([type])
}

model AIPrediction {
  id                String   @id @default(cuid())
  productId         String
  predictionType    String   // 'demand' | 'seasonal'
  predictedValue    Float    // % change attendu (ex: +30 = +30%)
  confidenceScore   Float    // 0-100
  periodStart       DateTime
  periodEnd         DateTime
  modelVersion      String   @default("v1.0")
  generatedAt       DateTime @default(now())

  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([predictionType])
}

model AIRecommendation {
  id              String   @id @default(cuid())
  fabricantId     String
  type            String   // 'seo' | 'trust' | 'publish_time' | 'competitive' | 'translation'
  content         String
  expectedImpactPct Int?
  status          String   @default("pending") // 'pending' | 'applied' | 'dismissed'
  createdAt       DateTime @default(now())

  @@index([fabricantId])
  @@index([status])
}

// === V3: Marketplace B2B ===

model Distributor {
  id              String   @id @default(cuid())
  userId          String   @unique
  companyName     String
  ninea           String?  // NINEA Sénégal
  rccm            String?  // Registre Commerce
  businessCategory String?
  regionsServed   String?  // CSV: "Dakar, Thiès, Saint-Louis"
  preferredCategories String? // CSV category IDs
  verified        Boolean  @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  b2bOrders       B2BOrder[] @relation("DistributorOrders")
  reviewsGiven    B2BReview[]   @relation("ReviewerReviews")
  contractsAsDistributor Contract[] @relation("DistributorContracts")
  conversations   Conversation[]

  @@index([verified])
}

model B2BProduct {
  id                  String   @id @default(cuid())
  productId           String   @unique
  distributorPriceTiers String? // JSON: [{minQty: 100, price: 1500}, ...]
  moq                 Int      @default(1) // Minimum Order Quantity
  paymentTerms        String?  // ex: "30 jours net"
  leadTimeDays        Int      @default(7)
  monthlyCapacity     Int?
  isB2BVisible        Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  b2bOrderItems       B2BOrderItem[]

  @@index([isB2BVisible])
}

model Conversation {
  id              String   @id @default(cuid())
  distributorId   String
  fabricantId     String
  productId       String?
  lastMessageAt   DateTime?
  createdAt       DateTime @default(now())

  distributor     Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  fabricant       User        @relation(fields: [fabricantId], references: [id], onDelete: Cascade)
  product         Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  messages        B2BMessage[]
  orders          B2BOrder[]

  @@index([distributorId])
  @@index([fabricantId])
}

model B2BMessage {
  id              String   @id @default(cuid())
  conversationId  String
  senderId        String   // User ID (fabricant or distributor's user)
  receiverId      String   // User ID
  senderRole      String   // 'fabricant' | 'distributor'
  content         String
  attachments     String?  // JSON: [{name, url}]
  isRead          Boolean  @default(false)
  readAt          DateTime?
  createdAt       DateTime @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User        @relation("B2BSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver        User        @relation("ReceiverMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([receiverId])
  @@index([isRead])
}

model B2BOrder {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  distributorId   String
  fabricantId     String
  conversationId  String?
  status          String   @default("quote_requested") // 'quote_requested' | 'quote_sent' | 'accepted' | 'rejected' | 'in_production' | 'shipped' | 'delivered' | 'cancelled'
  totalAmount     Int      @default(0) // en FCFA
  currency        String   @default("XOF")
  paymentStatus   String   @default("pending") // 'pending' | 'paid' | 'failed' | 'refunded'
  deliveryStatus  String   @default("pending") // 'pending' | 'preparing' | 'in_transit' | 'delivered'
  deliveryAddress String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  distributor     Distributor @relation("DistributorOrders", fields: [distributorId], references: [id], onDelete: Cascade)
  fabricant       User        @relation("FabricantOrders", fields: [fabricantId], references: [id], onDelete: Cascade)
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items           B2BOrderItem[]
  reviews         B2BReview[]

  @@index([distributorId])
  @@index([fabricantId])
  @@index([status])
}

model B2BOrderItem {
  id              String   @id @default(cuid())
  orderId         String
  b2bProductId    String
  quantity        Int
  unitPrice       Int      // en FCFA
  total           Int      // quantity * unitPrice

  order           B2BOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  b2bProduct      B2BProduct @relation(fields: [b2bProductId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model B2BReview {
  id                  String   @id @default(cuid())
  distributorReviewerId String   // Distributor ID (reviewer)
  fabricantReviewedId String   // Fabricant User ID (reviewed)
  orderId             String
  reliabilityScore    Int      // 1-5
  qualityScore        Int      // 1-5
  professionalismScore Int     // 1-5
  comment             String?
  createdAt           DateTime @default(now())

  reviewer            Distributor @relation("ReviewerReviews", fields: [distributorReviewerId], references: [id], onDelete: Cascade)
  reviewed            User        @relation("FabricantReviews", fields: [fabricantReviewedId], references: [id], onDelete: Cascade)
  order               B2BOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([distributorReviewerId])
  @@index([fabricantReviewedId])
}

model Contract {
  id                  String   @id @default(cuid())
  fabricantId         String
  distributorId       String
  type                String   // 'supply' | 'exclusivity' | 'whitelabel'
  title               String
  contentHtml         String
  signedByFabricantAt DateTime?
  signedByDistributorAt DateTime?
  signatureData       String?  // JSON
  pdfUrl              String?
  status              String   @default("draft") // 'draft' | 'sent' | 'signed' | 'expired' | 'terminated'
  validFrom           DateTime?
  validUntil          DateTime?
  createdAt           DateTime @default(now())

  fabricant           User        @relation("FabricantOrders", fields: [fabricantId], references: [id], onDelete: Cascade)
  distributor         Distributor @relation("DistributorContracts", fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([fabricantId])
  @@index([distributorId])
  @@index([status])
}

// === V3: Blockchain & Certifications ===

model BlockchainCertificate {
  id              String   @id @default(cuid())
  lotId           String   @unique
  txHash          String   @unique
  blockNumber     Int
  dataHash        String   // SHA-256 des données certifiées
  contractAddress String
  network         String   @default("polygon") // 'polygon' | 'mumbai' | 'hyperledger'
  certifiedAt     DateTime @default(now())

  lot             Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId])
  @@index([network])
}

model Certification {
  id              String   @id @default(cuid())
  fabricantId     String
  type            String   // 'bio' | 'halal' | 'iso22000' | 'fda' | 'haccp' | 'nsf' | 'cedeao'
  issuer          String   // organisme certificateur
  certificateNumber String?
  issuedAt        DateTime?
  expiresAt       DateTime?
  documentUrl     String?  // S3/IPFS URL
  verified        Boolean  @default(false)
  verifiedAt      DateTime?
  verificationMethod String? // 'api' | 'manual' | 'ocr'
  ocrMetadata     String?  // JSON: données extraites via OCR
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fabricant       User     @relation(fields: [fabricantId], references: [id], onDelete: Cascade)

  @@index([fabricantId])
  @@index([type])
  @@index([verified])
  @@index([expiresAt])
}

model ExportDocument {
  id              String   @id @default(cuid())
  lotId           String?
  fabricantId     String
  type            String   // 'ue_phytosanitary' | 'cedeao' | 'fda' | 'iso22000'
  destinationCountry String?
  generatedPdfUrl String?
  metadata        String?  // JSON
  generatedAt     DateTime @default(now())
  generatedBy     String

  fabricant       User     @relation(fields: [fabricantId], references: [id], onDelete: Cascade)

  @@index([fabricantId])
  @@index([type])
}

/// Public consumer review submitted after scanning a QR code.
/// No auth required — anyone with the lot URL can submit.
/// The fabricant is notified by email + in-app notification on creation.
model ProductReview {
  id            String   @id @default(cuid())
  lotId         String
  productId     String
  fabricantId   String   // merchant who owns the product — notified on creation
  rating        Int      // 1-5 overall rating
  comment       String?
  reviewerName  String?  // optional name left by the consumer
  reviewerPhone String?  // optional phone (useful for follow-up)
  createdAt     DateTime @default(now())

  lot           Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fabricant     User     @relation("ProductReviewFabricant", fields: [fabricantId], references: [id], onDelete: Cascade)

  @@index([lotId])
  @@index([productId])
  @@index([fabricantId])
}

// === V4: PWA, Rewards, Insights, A/B Testing, Nutrition ===

/// Lot recalled by the manufacturer or authorities.
/// One recall can affect multiple lots (batch issue).
model Recall {
  id              String   @id @default(cuid())
  title           String
  reason          String
  severity        String   @default("warning") // 'info' | 'warning' | 'critical'
  recallDate      DateTime @default(now())
  // Affected scope
  productId       String?
  lotIds          String?  // JSON array of lot IDs (CSV-compatible alternative)
  // Notification tracking
  notifiedScansCount Int   @default(0) // # of past scans that received push/SMS
  status          String   @default("active") // 'active' | 'resolved' | 'cancelled'
  authority       String?  // issuing body (SONAC, manufacturer, etc.)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId])
  @@index([status])
}

/// Loyalty wallet — one row per anonymous consumer (deviceFingerprint) OR per registered user.
model RewardWallet {
  id                  String   @id @default(cuid())
  deviceFingerprint   String?  // anonymous consumers
  userId              String?  // registered users (if linked)
  pointsBalance       Int      @default(0)
  totalEarned         Int      @default(0)
  totalRedeemed       Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  transactions        RewardTransaction[]
  redemptions         CouponRedemption[]

  @@unique([deviceFingerprint, userId])
  @@index([userId])
  @@index([deviceFingerprint])
}

/// Each scan (or action) generates points. Keeps an immutable ledger.
model RewardTransaction {
  id          String   @id @default(cuid())
  walletId    String
  scanId      String?  @unique // 1 scan = 1 transaction max
  type        String   // 'scan' | 'review' | 'referral' | 'bonus' | 'redemption'
  points      Int      // positive for earn, negative for redemption
  description String?
  createdAt   DateTime @default(now())

  wallet      RewardWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  scan        Scan?        @relation(fields: [scanId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([type])
}

/// Coupons offered by manufacturers — redeemable against points.
model Coupon {
  id              String   @id @default(cuid())
  fabricantId     String
  title           String
  description     String?
  pointsCost      Int      // points required to redeem
  discountValue   Int?     // discount value in FCFA
  discountPercent Int?     // OR discount percentage (mutually exclusive with value)
  productIds      String?  // JSON array of eligible product IDs (null = all)
  validFrom       DateTime @default(now())
  validUntil      DateTime
  totalQuantity   Int      @default(100)
  redeemedQuantity Int     @default(0)
  isActive        Boolean  @default(true)
  codePrefix      String   @default("VSCAN") // generates unique codes like VSCAN-XXXX
  createdAt       DateTime @default(now())

  redemptions     CouponRedemption[]

  @@index([fabricantId])
  @@index([isActive])
}

/// Tracks a coupon redeemed by a consumer.
model CouponRedemption {
  id          String   @id @default(cuid())
  couponId    String
  walletId    String
  code        String   @unique // generated unique code (e.g. VSCAN-AB12CD)
  pointsSpent Int
  status      String   @default("issued") // 'issued' | 'used' | 'expired'
  redeemedAt  DateTime @default(now())
  usedAt      DateTime?

  coupon      Coupon        @relation(fields: [couponId], references: [id], onDelete: Cascade)
  wallet      RewardWallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([walletId])
  @@index([status])
}

/// Premium weekly market insights generated per manufacturer.
/// Behind a paywall (Pro/Enterprise plans).
model MarketInsight {
  id              String   @id @default(cuid())
  fabricantId     String
  periodStart     DateTime
  periodEnd       DateTime
  totalScans      Int      @default(0)
  uniqueConsumers Int      @default(0)
  topRegion       String?
  topDayOfWeek    String?  // e.g. "Thursday"
  topHour         Int?     // 0-23
  growthPct       Float?   // vs previous period
  // Top region breakdown (JSON)
  regionsBreakdown String? // JSON: [{region, scans, share}]
  // Recommendations text
  summaryHtml     String?
  isPremium       Boolean  @default(true)
  generatedAt     DateTime @default(now())

  @@index([fabricantId])
  @@index([periodStart])
}

/// Anonymized competitor benchmark — share of scans within a category.
model CompetitorBenchmark {
  id              String   @id @default(cuid())
  fabricantId     String
  categoryId      String
  periodStart     DateTime
  periodEnd       DateTime
  totalCategoryScans Int   @default(0)
  fabricantScans  Int      @default(0)
  fabricantSharePct Float  @default(0)
  rank            Int      @default(1)
  topCompetitorSharePct Float? // leader's share (anonymized)
  generatedAt     DateTime @default(now())

  @@index([fabricantId])
  @@index([categoryId])
}

/// A/B testing of packaging — multiple QR codes per lot, each tied to a variant.
model PackagingVariant {
  id              String   @id @default(cuid())
  productId       String
  name            String   // e.g. "Design A — Rouge"
  description     String?
  qrCodeId        String?  // linked QR code (1:1 with variant)
  // Photo reference for IA matching (consumer scan photo vs this)
  referencePhotoUrl String?
  // Stats
  scansCount      Int      @default(0)
  conversionCount Int      @default(0) // # of scans leading to a desired action (review, purchase intent)
  status          String   @default("active") // 'draft' | 'active' | 'paused' | 'completed'
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime @default(now())

  @@index([productId])
  @@index([status])
}

/// Auto-synced certification from official APIs (SONAC, Halal, Bio, ISO).
/// Mirrors the manual Certification model but with `source: 'auto'`.
model OfficialCertification {
  id              String   @id @default(cuid())
  fabricantId     String
  source          String   // 'sonac' | 'halal' | 'bio' | 'iso' | 'fda'
  externalId      String   // ID from the official register
  certNumber      String?
  productNames    String?  // JSON array — products covered
  issuedAt        DateTime?
  expiresAt       DateTime?
  status          String   @default("valid") // 'valid' | 'expired' | 'suspended' | 'revoked'
  rawPayload      String?  // JSON snapshot from the API
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([source, externalId])
  @@index([fabricantId])
  @@index([source])
  @@index([status])
}

/// Nutrition info + carbon footprint per product.
/// Used for display on public product page + EU compliance prep.
model NutritionInfo {
  id              String   @id @default(cuid())
  productId       String   @unique
  // Nutri-Score (a/b/c/d/e) — computed from nutrients
  nutriScore      String?  // 'a' | 'b' | 'c' | 'd' | 'e'
  nutriScoreValue Int?     // -15 to +40 (algorithm input)
  // Per 100g
  energyKcal      Int?
  fatG            Float?
  saturatedFatG   Float?
  carbsG          Float?
  sugarsG         Float?
  fiberG          Float?
  proteinG        Float?
  saltG           Float?
  // Allergens (CSV)
  allergens       String?
  // Environmental
  carbonFootprintKgCo2e Float? // per kg of product
  waterFootprintL       Float? // per kg of product
  ecoScore             String? // 'a' | 'b' | 'c' | 'd' | 'e'
  // Ingredients
  ingredientsList String?
  // Source
  dataSource      String   @default("manual") // 'manual' | 'openfoodfacts' | 'ocr' | 'ai_generated'
  lastVerifiedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId])
}
