# This file is for LOCAL DEVELOPMENT ONLY.
# In production (Coolify), set these as environment variables in the service settings.
#
# Required in production:
#   DATABASE_URL       - SQLite path, e.g. file:/app/data/verifscan.db
#   NEXTAUTH_SECRET    - Random 32+ char string (openssl rand -base64 32)
#   NEXTAUTH_URL       - Full URL of the deployment, e.g. https://verifscan.roomscan.pro
#
# Optional (defaults shown):
#   ADMIN_EMAIL              - admin@verifscan.sn
#   ADMIN_PASSWORD           - admin123
#   DEMO_FABRICANT_EMAIL     - sarine@verifscan.sn
#   DEMO_FABRICANT_PASSWORD  - fabricant123
#   NEXT_PUBLIC_APP_URL      - (auto-detected from request headers if not set)

DATABASE_URL=file:./db/dev.db
